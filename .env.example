# Copy this file to `.env` in the same directory as docker-compose.yml and fill
# in real values. Docker Compose loads .env automatically - do NOT commit the
# real .env file to git (add it to .gitignore).
# It is also the source for the Kubernetes secret:
#   kubectl create secret generic shopease-secret --from-env-file=.env \
#     --dry-run=client -o yaml | kubectl apply -f -

# --- Database -----------------------------------------------------------
DB_NAME=shopease_db
DB_USERNAME=shopease_user
DB_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_PASSWORD

# --- JWT ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# --- Razorpay (payments) ---------------------------------------------------
# From https://dashboard.razorpay.com -> Settings -> API Keys (use LIVE keys
# for production, not the rzp_test_ ones)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_key_secret

# --- Cloudinary (product image storage/CDN) --------------------------------
# From https://console.cloudinary.com -> Dashboard -> "API Environment variable"
# Format: cloudinary://REPLACE_WITH_API_KEY:REPLACE_WITH_API_SECRET@REPLACE_WITH_CLOUD_NAME
CLOUDINARY_URL=cloudinary://REPLACE_WITH_API_KEY:REPLACE_WITH_API_SECRET@REPLACE_WITH_CLOUD_NAME

# --- OTP delivery (registration / login verification, password reset) -----
# Must be "false" for any real deployment - dev-mode echoes OTPs in API
# responses, which would let anyone verify/reset any account.
OTP_DEV_MODE=false

# --- SMTP (real email delivery for OTPs) -----------------------------------
# Required if OTP_DEV_MODE=false, or users will never receive their codes.
# IMPORTANT: Render blocks outbound SMTP ports 25/465/587, so use a provider
# that supports the alternate port 2525 (Brevo, SendGrid, Mailgun).
# Gmail SMTP will NOT work from Render in any configuration.
# Brevo: https://app.brevo.com -> SMTP & API (username = account email,
# password = generated SMTP key; also deactivate IP blocking for SMTP keys
# under Security -> Authorized IPs, or authorize your server's outbound IP).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USERNAME=your_brevo_account_email
SMTP_PASSWORD=your_brevo_smtp_key
# The address recipients see as the sender - must be a domain/address your
# SMTP provider has verified you're allowed to send as (see DEPLOYMENT notes).
MAIL_FROM=no-reply@yourdomain.com

# --- Brevo HTTP API (optional, recommended on Render) ----------------------
# From https://app.brevo.com -> SMTP & API -> API keys (v3). When set, OTPs
# are sent via Brevo's REST API over HTTPS - bypasses Render's SMTP port
# blocking and Brevo's SMTP IP authorization entirely. Takes priority over
# the SMTP settings above.
BREVO_API_KEY=

# --- Activates application-prod.yml (enables the SMTP config above and
#     forces OTP_DEV_MODE off at the Spring config level too) --------------
SPRING_PROFILES_ACTIVE=prod
